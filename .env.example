# ==============================================================================
# Voice Agent Configuration Template (.env.example)
# Copy this file to '.env' and fill in your real credentials.
# ==============================================================================

# OpenAI Configuration (LLM)
# Sign up at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Deepgram Configuration (Speech-to-Text)
# Sign up at https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Cartesia Configuration (Text-to-Speech)
# Sign up at https://cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key_here
# Sonic Voice ID (default: Barbershop Man / Friendly Assistant)
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# Daily.co WebRTC Configuration (Optional - for WebRTC room mode on Linux/WSL2/macOS)
# Sign up at https://daily.co
DAILY_API_KEY=your_daily_api_key_here
DAILY_SAMPLE_ROOM_URL=https://your-domain.daily.co/your-room-name
